{
  "expo": {
    "name": "Indigenous Rising",
    "slug": "indigenous-rising",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "indigenousrising",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.indigenousrising.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.indigenousrising.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8",
        "foregroundImage": "./assets/brand/icon-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F0E8",
          "image": "./assets/brand/icon-transparent.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#121614"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
