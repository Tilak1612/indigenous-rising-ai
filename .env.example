# Supabase Configuration (client-side, VITE_ prefix required)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Feature flags — 'true' enables; absent or anything else disables.
VITE_FEATURE_READINESS_WORKSPACE="false"

VITE_FEATURE_TESTIMONIALS="false"
